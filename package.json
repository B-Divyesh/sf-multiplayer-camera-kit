{
  "name": "multiplayer-camera-kit",
  "version": "0.1.0",
  "description": "Safe, inspectable multi-target camera framing for browser games",
  "type": "module",
  "main": "./dist/package/index.cjs",
  "module": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js",
      "require": "./dist/package/index.cjs"
    }
  },
  "files": [
    "dist/package",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "vite --config vite.config.ts",
    "build:lib": "tsup",
    "prepare:download": "node scripts/prepare-download.mjs",
    "build:site": "npm run build:lib && npm run prepare:download && vite build --config vite.config.ts",
    "build": "npm run clean && npm run build:site",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "test:consumer": "npm run build && node scripts/consumer.mjs",
    "test": "npm run test:unit && npm run test:e2e && npm run test:consumer",
    "typecheck": "npm run build:lib && tsc --noEmit"
  },
  "keywords": [
    "camera",
    "multiplayer",
    "canvas",
    "phaser",
    "pixi",
    "game-development"
  ],
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@types/node": "22.15.3",
    "playwright": "1.58.2",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
